{
  "name": "drissionpage-element-catcher",
  "version": "1.1.0",
  "private": true,
  "description": "DrissionPage 元素捕获器桌面客户端（Electron + FastAPI）",
  "author": "tslld",
  "main": "desktop/electron/main.js",
  "scripts": {
    "start": "electron .",
    "backend:build": "pyinstaller desktop/backend.spec --noconfirm --distpath build/backend --workpath build/pyinstaller",
    "dist:dir": "node desktop/build_dir.js"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tslld.drissionpage.catcher",
    "productName": "DrissionPage元素捕获器",
    "executableName": "DrissionPageCatcher",
    "directories": {
      "output": "dist_client",
      "buildResources": "desktop/electron"
    },
    "files": [
      "desktop/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/DPCBackend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "desktop/electron/icon.ico"
    },
    "asar": false
  }
}
